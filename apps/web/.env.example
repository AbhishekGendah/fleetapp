# Base URL of this app (no trailing slash). Used to build absolute links
# instead of hardcoding a domain. Vercel preview deployments should set this
# to their own preview URL.
APP_URL=http://localhost:3000

# Runtime Postgres connection string, non-owner app role (RLS enforced),
# using Neon's POOLED connection ("-pooler" in the hostname).
# See packages/db/.env.example for how this is created.
DATABASE_URL=postgres://app_role:password@host-pooler.neon.tech/fleetapp?sslmode=require
