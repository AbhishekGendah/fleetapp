# Base URL of this app (no trailing slash). Used to build absolute links
# instead of hardcoding a domain. Vercel preview deployments should set this
# to their own preview URL.
APP_URL=http://localhost:3000

# Runtime Postgres connection string, non-owner app role (RLS enforced),
# using Neon's POOLED connection ("-pooler" in the hostname).
# See packages/db/.env.example for how this is created.
DATABASE_URL=postgres://web_app_role:password@host-pooler.neon.tech/fleetapp?sslmode=require

# Connection string for `web_auth_role`, the database role used ONLY by the
# Operator login system. It can reach the User credential tables; the role in
# DATABASE_URL above cannot. Pooled connection, same as DATABASE_URL.
AUTH_DATABASE_URL=postgres://web_auth_role:password@host-pooler.neon.tech/fleetapp?sslmode=require

# Encrypts authenticator secrets and recovery codes, and signs session tokens.
# At least 32 characters, generated randomly, DIFFERENT from the admin app's.
# LOSING THIS MEANS EVERY USER MUST RE-ENROL THEIR AUTHENTICATOR APP.
# Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=

# The name shown against the entry in a User's authenticator app: in effect
# the product name. Awkward to change later: existing entries keep the old name
# until re-enrolled.
AUTH_ISSUER_NAME=Product Name

# How email is sent. `dev_outbox` keeps every email in the test inbox on the
# admin site instead of sending it. NEVER use it in production: the inbox
# holds working password reset links.
EMAIL_TRANSPORT=dev_outbox

# Sender name and address shown on every email.
EMAIL_FROM="Product Name <no-reply@example.com>"

# Google Places (New) key for address lookup. Server only, never NEXT_PUBLIC_.
# In Google Cloud: restrict it to "Places API (New)" and set daily caps on
# AutocompletePlacesRequest and GetPlaceRequest. Kept in Bitwarden.
GOOGLE_PLACES_API_KEY=

# The Places (New) service address. The browser tests point this at a stand-in.
GOOGLE_PLACES_API_URL=https://places.googleapis.com

# File storage: two private Amazon S3 buckets in Sydney. One for general files
# (logos, car photos), one only for identity documents (rule 8). Never public:
# files are shown through links that expire in minutes.
STORAGE_BUCKET=altus-fleetapp-dev-files
IDENTITY_STORAGE_BUCKET=altus-fleetapp-dev-identity
FILE_STORAGE_REGION=ap-southeast-2
# The app's own Amazon login, limited to the two buckets above. Kept in
# Bitwarden and Vercel. Not AWS_ACCESS_KEY_ID: Vercel sets that name itself.
FILE_STORAGE_ACCESS_KEY_ID=
FILE_STORAGE_SECRET_ACCESS_KEY=

# Only for the browser tests' local S3 stand-in (MinIO). Leave unset: Amazon is used.
# FILE_STORAGE_ENDPOINT=http://localhost:9000

# Proves a scheduled job's call (the daily file clean-up) comes from Vercel's
# scheduler. Random, at least 32 characters; kept in Bitwarden and Vercel.
CRON_SECRET=

# Where AGS is emailed when the nightly run fails or runs out of time. Counts
# only, never Renter details. An AGS inbox someone reads.
OPS_ALERT_EMAIL=

# How the app reaches Stripe: "off" until the AGS Stripe account is set up
# (payments by Stripe are not offered), "stripe" for real. "stand_in" is for
# the browser tests only and is refused in production.
PAYMENTS_TRANSPORT=off
# The AGS platform account's secret key (sk_test_… on the dev site, sk_live_…
# in production) and the events endpoint's signing secret. Kept in Bitwarden
# and Vercel only; never pasted anywhere else.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# The second event destination's signing secret: events about each business's
# own account (a Renter's direct debit and payments). Same endpoint. Until it is
# set, Renters are not offered Stripe's page.
STRIPE_CONNECT_WEBHOOK_SECRET=

# "production" only in the real production project, with real Renters;
# "development" on the dev site, previews and here. The test inbox
# (EMAIL_TRANSPORT=dev_outbox) and the Stripe stand-in run only with
# "development", and a live Stripe key only with "production".
APP_STAGE=development
