{
  "$schema": "https://turborepo.com/schema.json",
  "extends": ["//"],
  "tasks": {
    "build": {
      "env": [
        "APP_URL",
        "DATABASE_URL",
        "AUTH_DATABASE_URL",
        "BETTER_AUTH_SECRET",
        "AUTH_ISSUER_NAME",
        "EMAIL_TRANSPORT",
        "EMAIL_FROM"
      ]
    },
    "dev": {
      "env": [
        "APP_URL",
        "DATABASE_URL",
        "AUTH_DATABASE_URL",
        "BETTER_AUTH_SECRET",
        "AUTH_ISSUER_NAME",
        "EMAIL_TRANSPORT",
        "EMAIL_FROM"
      ]
    },
    "test": {
      "cache": false,
      "env": ["TEST_POSTGRES_SUPERUSER_URL"]
    }
  }
}
