{
  "$schema": "https://turborepo.com/schema.json",
  "extends": ["//"],
  "tasks": {
    "build": {
      "env": [
        "APP_URL",
        "DATABASE_URL",
        "AUTH_DATABASE_URL",
        "BETTER_AUTH_SECRET",
        "AUTH_ISSUER_NAME",
        "EMAIL_TRANSPORT",
        "EMAIL_FROM",
        "GOOGLE_PLACES_API_KEY",
        "STORAGE_BUCKET",
        "IDENTITY_STORAGE_BUCKET",
        "FILE_STORAGE_REGION",
        "FILE_STORAGE_ACCESS_KEY_ID",
        "FILE_STORAGE_SECRET_ACCESS_KEY",
        "CRON_SECRET"
      ]
    },
    "dev": {
      "env": [
        "APP_URL",
        "DATABASE_URL",
        "AUTH_DATABASE_URL",
        "BETTER_AUTH_SECRET",
        "AUTH_ISSUER_NAME",
        "EMAIL_TRANSPORT",
        "EMAIL_FROM",
        "GOOGLE_PLACES_API_KEY",
        "STORAGE_BUCKET",
        "IDENTITY_STORAGE_BUCKET",
        "FILE_STORAGE_REGION",
        "FILE_STORAGE_ACCESS_KEY_ID",
        "FILE_STORAGE_SECRET_ACCESS_KEY",
        "CRON_SECRET"
      ]
    },
    "test": {
      "cache": false,
      "env": ["TEST_POSTGRES_SUPERUSER_URL"]
    }
  }
}
