# Base URL of this app (no trailing slash). Used to build absolute links
# instead of hardcoding a domain. Vercel preview deployments should set this
# to their own preview URL.
ADMIN_URL=http://localhost:3001

# Runtime Postgres connection string, non-owner app role (RLS enforced),
# using Neon's POOLED connection ("-pooler" in the hostname).
# See packages/db/.env.example for how this is created. Admin uses its own
# DB credentials, separate from apps/web.
DATABASE_URL=postgres://app_role:password@host-pooler.neon.tech/fleetapp?sslmode=require

# Connection string for `admin_auth_role`, the database role used ONLY by the
# login system. It can reach the Admin credential tables; the role in
# DATABASE_URL above cannot. Pooled connection, same as DATABASE_URL.
AUTH_DATABASE_URL=postgres://admin_auth_role:password@host-pooler.neon.tech/fleetapp?sslmode=require

# Encrypts authenticator secrets and recovery codes, and signs session tokens.
# At least 32 characters, generated randomly, different from the Operator app's.
# LOSING THIS MEANS EVERY ADMIN MUST RE-ENROL THEIR AUTHENTICATOR APP.
# Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=

# The name shown against the entry in an Admin's authenticator app. Awkward to
# change later: existing entries keep the old name until re-enrolled.
AUTH_ISSUER_NAME=Altus Global Solutions
