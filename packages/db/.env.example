# Runtime connection string for the app's non-owner Postgres role.
# RLS is enabled AND forced on every tenant table; this role must NOT have
# BYPASSRLS. Used by apps/web and apps/admin at request time.
DATABASE_URL=postgres://app_role:password@host.neon.tech/fleetapp?sslmode=require

# Owner-role connection string. Used only by drizzle-kit to run migrations,
# never by the running app.
DATABASE_MIGRATION_URL=postgres://owner_role:password@host.neon.tech/fleetapp?sslmode=require
