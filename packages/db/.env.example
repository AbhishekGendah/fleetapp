# Runtime connection string for the app's non-owner Postgres role, using
# Neon's POOLED connection (the one with "-pooler" in the hostname).
# RLS is enabled AND forced on every tenant table; this role must NOT have
# BYPASSRLS. Used by apps/web and apps/admin at request time.
DATABASE_URL=postgres://app_role:password@host-pooler.neon.tech/fleetapp?sslmode=require

# Owner-role connection string. Used only by drizzle-kit to run migrations,
# never by the running app. Must be Neon's DIRECT (unpooled) connection
# string, no "-pooler" in the hostname — drizzle-kit needs a real session
# (advisory locks, DDL) that Neon's pooled/PgBouncer connection doesn't
# reliably support.
DATABASE_MIGRATION_URL=postgres://owner_role:password@host.neon.tech/fleetapp?sslmode=require

# OPTIONAL, tests only. Superuser connection string for a Postgres that is
# already running. Set it to test against that server instead of starting a
# throwaway Docker container — useful where Docker image pulls are blocked.
# Leave it unset and the tests start `postgres:17-alpine` themselves.
# TEST_POSTGRES_SUPERUSER_URL=postgres://postgres:password@127.0.0.1:5432/postgres
